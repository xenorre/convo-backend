# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
# MongoDB connection string, e.g. mongodb+srv://user:pass@cluster/db
DATABASE_URL=

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Cookies
# Align cookie max age with your session policy (milliseconds)
COOKIE_MAX_AGE_MS=900000

# Arcjet
ARCJET_KEY=

# Logging
LOG_LEVEL=info
# Enable file transports in production only when needed (true/false)
LOG_TO_FILES=false

# Resend
EMAIL_FROM=
EMAIL_FROM_NAME=
RESEND_API_KEY=
CLIENT_URL=

# Socket.IO scaling (optional)
REDIS_URL=

# Storage Configuration (S3 Compatible)
STORAGE_URL=
# If using Supabase Storage, set the public base URL including 'storage/v1/object/public'
# e.g. https://<project>.supabase.co/storage/v1/object/public
STORAGE_PUBLIC_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
